{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Bienvenido a la documentación para desarrolladores de Bluechat",
  "description": "La guía completa para configurar e integrar Bluechat, la plataforma de soporte al cliente.",

  "colors": {
    "primary": "#0166ff",
    "light": "#0166ff",
    "dark": "#0166ff"
  },

  "background": {
    "color": {
      "dark": "#0a0c10"
    }
  },

  "appearance": {
    "strict": true
  },

  "fonts": {
    "family": "Rubik",
    "weight": 400
  },

  "favicon": {
    "light": "/images/logobluechatfavicon.png",
    "dark": "/images/logobluechatfavicon.png"
  },

  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo_dark.png"
  },

  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:soporte@bluechat.lat"
      }
    ]
  },


  "features": {
    "copyPage": false
  },

  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "color": {
            "light": "#0166ff",
            "dark": "#0166ff"
          },
          "href": "https://developers.bluechat.lat/"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "color": {
            "light": "#0166ff",
            "dark": "#0166ff"
          },
          "href": "https://bluechat.lat/blog"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "hidden": true,
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Customization",
            "hidden": true,
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "hidden": true,
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "hidden": true,
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "Referencia de API",
        "groups": [
          {
            "group": "Empezando",
            "pages": [
              "api-reference/Introduccion"
            ]
          },
          {
            "group": "APIs de Aplicación",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ]
  },

  "footer": {
    "socials": {
      "github": "https://github.com/bluechatcrm",
      "website": "https://bluechat.lat"
    }
  }
}
