{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Documentación para desarrolladores de Bluechat",
  "colors": {
    "primary": "#0166ff",
    "light": "#0166ff",
    "dark": "#0166ff"
  },
  "favicon": {
    "light": "/images/logobluechatfavicon.png",
    "dark": "/images/logobluechatfavicon.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentación",
          "icon": "book-open-cover",
          "href": "https://developers.bluechat.lat/"
        },
        {
          "anchor": "Sitio Web",
          "icon": "newspaper",
          "href": "https://bluechat.lat/"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guías",
        "groups": [
          {
            "group": "Introducción",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          }
        ]
      },
      {
        "tab": "Referencia de API",
        "groups": [
          {
            "group": "Cuentas (Accounts)",
            "pages": [
              "api/accounts/get-account",
              "api/accounts/update-account"
            ]
          },
          {
            "group": "Agentes (Agents)",
            "pages": [
              "api/agents/list-agents",
              "api/agents/create-agent",
              "api/agents/update-agent",
              "api/agents/delete-agent"
            ]
          },
          {
            "group": "Contactos (Contacts)",
            "pages": [
              "api/contacts/list-contacts",
              "api/contacts/create-contact",
              "api/contacts/update-contact",
              "api/contacts/delete-contact"
            ]
          },
          {
            "group": "Conversaciones (Conversations)",
            "pages": [
              "api/conversations/list-conversations",
              "api/conversations/create-conversation",
              "api/conversations/send-message",
              "api/conversations/resolve-conversation"
            ]
          },
          {
            "group": "Integraciones",
            "pages": [
              "api/integrations/list-hooks",
              "api/integrations/create-hook",
              "api/integrations/delete-hook"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo_dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Soporte",
        "href": "mailto:soporte@bluechat.lat"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/bluechatcrm",
      "website": "https://bluechat.lat"
    }
  },
  "fonts": {
    "family": "Roboto"
  },
  "description": "Guía oficial para integrar y desarrollar sobre la API REST de Bluechat (basado en Chatwoot Open Source).",
  "background": {
    "color": {
      "dark": "#0a0c10"
    }
  },
  "appearance": {
    "strict": true
  }
}
